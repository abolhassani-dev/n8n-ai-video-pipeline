{
  "name": "AI Video Pipeline - Telegram Controlled",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "telegram-trigger",
      "name": "Telegram Command Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "webhookId": "telegram-video-trigger",
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-cred",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "command-check",
              "leftValue": "={{ $json.message.text }}",
              "rightValue": "/generate",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "command-filter",
      "name": "Filter /generate Command",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "🎬 Starting video generation pipeline...\n\nTopic: {{ $json.message.text.replace('/generate', '').trim() }}",
        "additionalFields": {}
      },
      "id": "ack-message",
      "name": "Acknowledge Request",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        680,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-cred",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4-turbo",
          "mode": "list",
          "cachedResultName": "gpt-4-turbo"
        },
        "messages": {
          "values": [
            {
              "content": "You are a creative director generating viral short-form video concepts. Output ONLY valid JSON with no markdown.",
              "role": "system"
            },
            {
              "content": "=Create a viral 8-second video concept on this topic: {{ $('Filter /generate Command').item.json.message.text.replace('/generate', '').trim() }}\n\nReturn JSON with exactly these fields:\n{\n  \"image_prompt\": \"detailed cinematic image prompt, max 200 chars\",\n  \"video_prompt\": \"motion description for the image, max 150 chars\",\n  \"voiceover\": \"dramatic narration text, max 30 words\",\n  \"title\": \"viral title under 60 chars\",\n  \"hashtags\": \"5-7 hashtags space-separated\"\n}",
              "role": "user"
            }
          ]
        },
        "jsonOutput": true,
        "options": {
          "temperature": 0.8
        }
      },
      "id": "prompt-generator",
      "name": "GPT-4 Prompt Generator",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.7,
      "position": [
        900,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai-cred",
          "name": "OpenAI"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://queue.fal.run/fal-ai/flux-pro/v1.1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"prompt\": \"{{ $json.message.content.image_prompt }}\",\n  \"image_size\": \"portrait_16_9\",\n  \"num_inference_steps\": 28,\n  \"num_images\": 1,\n  \"enable_safety_checker\": true\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "flux-submit",
      "name": "Submit Image to Fal.ai Flux",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "fal-cred",
          "name": "Fal.ai API Key"
        }
      }
    },
    {
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      },
      "id": "wait-flux",
      "name": "Wait for Flux (15s)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1340,
        300
      ],
      "webhookId": "wait-flux-webhook"
    },
    {
      "parameters": {
        "url": "={{ $('Submit Image to Fal.ai Flux').item.json.status_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "flux-poll",
      "name": "Poll Flux Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "fal-cred",
          "name": "Fal.ai API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "status-check",
              "leftValue": "={{ $json.status }}",
              "rightValue": "COMPLETED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "flux-status-check",
      "name": "Check Flux Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1780,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Submit Image to Fal.ai Flux').item.json.response_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "flux-fetch-result",
      "name": "Fetch Image URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "fal-cred",
          "name": "Fal.ai API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.klingai.com/v1/videos/image2video",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"model_name\": \"kling-v1\",\n  \"image\": \"{{ $json.images[0].url }}\",\n  \"prompt\": \"{{ $('GPT-4 Prompt Generator').item.json.message.content.video_prompt }}\",\n  \"duration\": \"5\",\n  \"aspect_ratio\": \"9:16\",\n  \"cfg_scale\": 0.5\n}",
        "options": {}
      },
      "id": "kling-submit",
      "name": "Submit to Kling.ai",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2220,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "kling-cred",
          "name": "Kling API Key"
        }
      }
    },
    {
      "parameters": {
        "amount": 60,
        "unit": "seconds"
      },
      "id": "wait-kling",
      "name": "Wait for Kling (60s)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2440,
        200
      ],
      "webhookId": "wait-kling-webhook"
    },
    {
      "parameters": {
        "url": "=https://api.klingai.com/v1/videos/image2video/{{ $('Submit to Kling.ai').item.json.data.task_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "kling-poll",
      "name": "Poll Kling Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2660,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "kling-cred",
          "name": "Kling API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "kling-status",
              "leftValue": "={{ $json.data.task_status }}",
              "rightValue": "succeed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "kling-status-check",
      "name": "Check Kling Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2880,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.elevenlabs.io/v1/text-to-speech/21m00Tcm4TlvDq8ikWAM",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "audio/mpeg"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"text\": \"{{ $('GPT-4 Prompt Generator').item.json.message.content.voiceover }}\",\n  \"model_id\": \"eleven_multilingual_v2\",\n  \"voice_settings\": {\n    \"stability\": 0.5,\n    \"similarity_boost\": 0.75,\n    \"style\": 0.4,\n    \"use_speaker_boost\": true\n  }\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "elevenlabs-tts",
      "name": "Generate Voiceover (ElevenLabs)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3100,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "elevenlabs-cred",
          "name": "ElevenLabs API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.creatomate.com/v1/renders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"template_id\": \"YOUR_CREATOMATE_TEMPLATE_ID\",\n  \"modifications\": {\n    \"video_source\": \"{{ $('Poll Kling Result').item.json.data.task_result.videos[0].url }}\",\n    \"audio_source\": \"{{ $('Generate Voiceover (ElevenLabs)').item.json.audio_url }}\",\n    \"title_text\": \"{{ $('GPT-4 Prompt Generator').item.json.message.content.title }}\"\n  }\n}",
        "options": {}
      },
      "id": "creatomate-render",
      "name": "Render Final Video (Creatomate)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3320,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "creatomate-cred",
          "name": "Creatomate API Key"
        }
      }
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "wait-creatomate",
      "name": "Wait for Render (30s)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        3540,
        100
      ],
      "webhookId": "wait-creatomate-webhook"
    },
    {
      "parameters": {
        "url": "=https://api.creatomate.com/v1/renders/{{ $('Render Final Video (Creatomate)').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "creatomate-poll",
      "name": "Poll Creatomate Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3760,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "creatomate-cred",
          "name": "Creatomate API Key"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Filter /generate Command').item.json.message.chat.id }}",
        "operation": "sendVideo",
        "binaryData": false,
        "video": "={{ $json.url }}",
        "additionalFields": {
          "caption": "=✅ **Video ready for review**\n\n📌 **Title:** {{ $('GPT-4 Prompt Generator').item.json.message.content.title }}\n\n🏷️ **Hashtags:** {{ $('GPT-4 Prompt Generator').item.json.message.content.hashtags }}\n\nReply with /approve to publish or /reject to discard.",
          "parse_mode": "Markdown"
        }
      },
      "id": "send-result",
      "name": "Send Result to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        3980,
        100
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-cred",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Filter /generate Command').item.json.message.chat.id }}",
        "text": "❌ Pipeline failed at: {{ $node.name }}\n\nError details have been logged. Please check the n8n execution log.",
        "additionalFields": {}
      },
      "id": "error-handler",
      "name": "Pipeline Error Handler",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2000,
        500
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-cred",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Filter /generate Command').item.json.message.chat.id }}",
        "text": "⚠️ Unknown command. Use /generate <topic> to start a new video.",
        "additionalFields": {}
      },
      "id": "unknown-command",
      "name": "Unknown Command Response",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        680,
        400
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-cred",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Telegram Command Trigger": {
      "main": [
        [
          {
            "node": "Filter /generate Command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter /generate Command": {
      "main": [
        [
          {
            "node": "Acknowledge Request",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Unknown Command Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Acknowledge Request": {
      "main": [
        [
          {
            "node": "GPT-4 Prompt Generator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GPT-4 Prompt Generator": {
      "main": [
        [
          {
            "node": "Submit Image to Fal.ai Flux",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit Image to Fal.ai Flux": {
      "main": [
        [
          {
            "node": "Wait for Flux (15s)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Flux (15s)": {
      "main": [
        [
          {
            "node": "Poll Flux Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Flux Result": {
      "main": [
        [
          {
            "node": "Check Flux Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Flux Status": {
      "main": [
        [
          {
            "node": "Fetch Image URL",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Pipeline Error Handler",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Image URL": {
      "main": [
        [
          {
            "node": "Submit to Kling.ai",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit to Kling.ai": {
      "main": [
        [
          {
            "node": "Wait for Kling (60s)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Kling (60s)": {
      "main": [
        [
          {
            "node": "Poll Kling Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Kling Result": {
      "main": [
        [
          {
            "node": "Check Kling Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Kling Status": {
      "main": [
        [
          {
            "node": "Generate Voiceover (ElevenLabs)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Pipeline Error Handler",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Voiceover (ElevenLabs)": {
      "main": [
        [
          {
            "node": "Render Final Video (Creatomate)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render Final Video (Creatomate)": {
      "main": [
        [
          {
            "node": "Wait for Render (30s)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Render (30s)": {
      "main": [
        [
          {
            "node": "Poll Creatomate Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Creatomate Result": {
      "main": [
        [
          {
            "node": "Send Result to Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": true
  },
